# Database Configuration
# For local development with SQLite (change schema.prisma provider to "sqlite"):
# DATABASE_URL="file:./dev.db"

# For production with PostgreSQL (recommended for Vercel):
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Vercel Postgres (automatically provided by Vercel):
# POSTGRES_URL will be automatically set by Vercel
# Just use DATABASE_URL="${POSTGRES_URL}" in your Vercel environment variables

# Or use any PostgreSQL provider:
DATABASE_URL="postgresql://user:password@host:5432/database"

# Optional: Set this if you have Prisma binary download issues in local dev
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
